# --- Database (SQLite by default) ---
# This path is relative to the prisma/ directory, so the file lands at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Storage (Cloudflare R2 or AWS S3) ---
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT empty
S3_ENDPOINT="https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="comfyui-vast-studio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: public/CDN URL prefix; if empty, signed URLs are generated.
# Example R2 public bucket URL: https://pub-<id>.r2.dev
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Vast.ai (instance you reuse) ---
VAST_API_KEY=""
VAST_INSTANCE_ID=""
VAST_API_URL="https://console.vast.ai/api/v0"

# --- ComfyUI exposed by your Vast.ai instance ---
# Usually http://<host>:<mapped-port> from Vast.ai's port mapping (port 8188 internally).
COMFYUI_URL="http://YOUR_VAST_HOST:8188"
COMFYUI_CLIENT_ID="comfyui-vast-studio"

# --- GPU lifecycle ---
GPU_IDLE_TIMEOUT_MINUTES="10"
GPU_AUTO_WAKE="true"
GPU_BOOT_TIMEOUT_SECONDS="600"

# --- Optional auth (Basic Auth) for the web UI ---
BASIC_AUTH_PASSWORD=""

# --- Cron secret for /api/cron/idle-watcher ---
CRON_SECRET=""
